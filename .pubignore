# The example app only exists to demonstrate the public API and to run
# example/test/widget_test.dart. The platform runner directories (iOS,
# and any others added later such as Android/macOS/Linux/Windows/Web) are
# boilerplate generated by `flutter create` — they add no value to
# someone browsing the package on pub.dev and only bloat the published
# archive, so they are excluded here. example/lib, example/pubspec.yaml,
# and example/test are intentionally NOT listed and remain published.
example/ios/
example/android/
example/macos/
example/linux/
example/windows/
example/web/

# Build artifacts. Pub already excludes these by default, but they are
# listed explicitly here so the exclusion doesn't depend on that default
# behavior.
build/
example/build/

# IDE project files. This package is not checked into a Git repository,
# so pub does not consult .gitignore here; without an explicit entry
# these leak into the published archive.
*.iml
.idea/
